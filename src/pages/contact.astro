---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/contact/contact_form.astro";
import { Image } from "astro:assets";
import daniel from "../assets/hosts/primary_host.webp";
import rebecca from "../assets/hosts/secondary_host.webp";
import { Content as About } from "../components/contact/about_us.md";
import property from "../data/property.json";
---
<Layout title="Contact your hosts">
  <section class="page shell"><span class="eyebrow">We’re here to help</span><div class="contact-grid">
    <div>
      <div class="host-intro"><span class="avatars"><Image src={rebecca} alt="Rebecca" /><Image src={daniel} alt="Daniel" /></span><h1 class="page-title">Your hosts, Rebecca &amp; Daniel</h1><p class="page-lead" style="margin-inline:auto">English, Maltese, Italian · best reached by text or email</p></div>
      <div class="contact-actions"><a class="button" href={`https://wa.me/${property.contact.phone.replace(/\D/g, "")}`}>💬 WhatsApp</a><a class="button secondary" href={`tel:${property.contact.phone}`}>📞 {property.contact.phone}</a><a class="button secondary wide" href={`mailto:${property.contact.email}`}>✉️ Email us</a></div>
      <div class="card prose-card"><About /></div>
    </div>
    <ContactForm />
  </div></section>
</Layout>
