import property from '../data/property.json';
import ContactForm from '../components/contact/contact_form.astro';

import PropertyThingsToKnow from '../components/PropertyThingsToKnow.astro';
---

<Layout>
  <div class="space-y-8">
    <div>
      <h1>Contact Your Hosts</h1>
      <div class="container mx-auto p-4">
        <ContactForm />

        <PropertyThingsToKnow />
      </div>
    </div>
  </div>
</Layout>
