---
import Layout from '../layouts/Layout.astro';
import {Content as AboutUs} from '../components/contact/about_us.md';
import { Mail, PhoneCall, Languages } from '@lucide/astro';
import property from '../data/property.json'

import PropertyThingsToKnow from '../components/PropertyThingsToKnow.astro';
---

<Layout>
  <div class="space-y-8">
    <div>
      <h1>Your Hosts</h1>
      <div class="space-y-8">
        <div class="card bg-white shadow-xl mt-4">
          <div class="card-body items-center">
            <div class="italic">
              <AboutUs/>
            </div>
          </div>
        </div>

      </div>
      <PropertyThingsToKnow />
    </div>
  </div>
</Layout>