---
import 'leaflet/dist/leaflet.css';
import property from '../data/property.json';

const { coordinates, address } = property.location;
---

<div id="map" style="height: 500px;" data-coordinates={JSON.stringify(coordinates)} data-address={address}></div>

<script>
  import { initMap } from '../scripts/map.js';
  const mapElement = document.getElementById('map');
  if (mapElement && mapElement.dataset.coordinates && mapElement.dataset.address) {
    const coordinates = JSON.parse(mapElement.dataset.coordinates);
    const address = mapElement.dataset.address;
    initMap(coordinates, address);
  }
</script>

<style>
  #map { width: 100%; }
</style>
