---
import xlendi from "../../assets/images/places/xlendibay.webp";
import citadella from "../../assets/images/places/citadella.webp";
import sanap from "../../assets/images/places/sanap-cliffs.webp";
import tapinu from "../../assets/images/places/tapinu.webp";
import ghasri from "../../assets/images/places/ghasri.webp";
const places = [
  { title: "Xlendi Bay", tag: "On your doorstep", accent: true, image: xlendi, alt: "Sunset over Xlendi Bay", copy: "Famous for its sunsets, restaurants and diving. Watch the sunset from a waterfront table — or our own balcony." },
  { title: "Cittadella", tag: "15 min by bus", image: citadella, alt: "Cittadella in Victoria", copy: "The medieval fortified town in Victoria. Visit by day for the 360° views and shops, and by night for the lights." },
  { title: "Sanap Cliffs walk", tag: "Round the corner", accent: true, image: sanap, alt: "View from Sanap Cliffs", copy: "A popular walk to the majestic Sanap Cliffs and Xlendi Tower. We’ve done it many times — ask us about the route." },
  { title: "Ta’ Pinu Basilica", tag: "In Għarb", image: tapinu, alt: "Ta Pinu Basilica", copy: "A Roman Catholic basilica full of sculpture and carved stonework — a masterpiece for art and culture fans." },
  { title: "Wied il-Għasri", tag: "Hidden gem", image: ghasri, alt: "Wied il-Ghasri inlet", copy: "A tiny pebbly beach wedged between cliffs. Go early in the morning and you might get the bay to yourself." },
];
---
<div class="places-grid">
  {places.map((place) => <article class="card place-card"><img src={place.image.src} alt={place.alt} loading="lazy" /><div class="place-copy"><div class="place-head"><h3>{place.title}</h3><span class:list={["pill", { accent: place.accent }]}>{place.tag}</span></div><p>{place.copy}</p></div></article>)}
  <a class="card place-card" href="/getting-here" style="display:grid;place-items:center;padding:28px;text-align:center"><div><h3>Tourist map of Malta &amp; Gozo</h3><p>See the VisitMalta map and directions on the Getting here page.</p><span class="button secondary small">View map</span></div></a>
</div>
