---
import BookNow from '../components/BookNow.astro';
import { Image } from 'astro:assets';
import { Coffee, Sun, Lock, Star, StarHalf } from '@lucide/astro';
import property from '../data/property.json' assert { type: 'json' };
import primaryHostAvatar from '../assets/hosts/primary_host.webp';
import secondaryHostAvatar from '../assets/hosts/secondary_host.webp';

const hostAvatars = {
    primary_host: primaryHostAvatar,
    secondary_host: secondaryHostAvatar
};

type HostAvatarKey = keyof typeof hostAvatars;

interface Rating {
    rating: number;
    maxRating: number;
    link: string;
}

const renderStars = (rating: number, maxRating: number = 5) => {
    const normalizedRating = (rating / maxRating) * 5;
    const fullStars = Math.floor(normalizedRating);
    const halfStar = normalizedRating % 1 >= 0.5 ? 1 : 0;
    const emptyStars = 5 - fullStars - halfStar;
    return { fullStars, halfStar, emptyStars };
};

const starSize = 15;
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="p-4 ">
        <h2 class="text-2xl font-bold">{property.subtitle}</h2>
        {Object.entries(property.ratings).map(([platform, ratingInfo]) => {
            const rating = ratingInfo as Rating;
            const stars = renderStars(rating.rating, rating.maxRating);
            return (
                <div class="flex items-center mt-2 rounded-lg hover:bg-base-200 p-1">
                    <span class="text-yellow-500 flex items-center">
                        {Array(stars.fullStars).fill(0).map(() => <Star class="inline-block" size={starSize} fill="currentColor" />)}
                        {stars.halfStar === 1 && <StarHalf class="inline-block" size={starSize} fill="currentColor" />}
                        {Array(stars.emptyStars).fill(0).map(() => <Star class="inline-block" size={starSize} />)}
                        <span class="ml-2">{rating.rating}</span>
                    </span>
                    <a target="_blank" href={rating.link} class="ml-2 text-gray-600 italic">
                        (reviews on {platform.charAt(0).toUpperCase() + platform.slice(1)})
                    </a>
                </div>
            )
        })}

        <p class="text-gray-600 mt-2">{property.description}</p>
        <p class="text-gray-600">{property.details.join(' · ')}</p>
        <div x-data class="grid grid-cols-2 mt-4">
            {property.hosts.map(host => (
                <div x-on:click="window.location.href='/contact'" class="flex items-center cursor-pointer p-2 rounded-lg hover:bg-base-200">
                    <Image src={hostAvatars[host.avatar as HostAvatarKey]} alt={`${host.name}'s Avatar`} class="w-12 h-12 rounded-full mr-4 object-cover" widths={[48, 96, 144]} sizes="48px" />
                    <div>
                        <h3 class="font-semibold">{host.role} {host.name}</h3>
                        <p class="text-gray-600">{host.hosting_since}</p>
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-4 space-y-2">
            <div class="flex items-center">
            <Lock class="mr-2" /> <p class="text text-gray-600">Self check-in with lockbox</p>
            </div>
            <div class="flex items-center">
            <Sun class="mr-2" /> <p class="text text-gray-600">Scenic Area</p>
            </div>
            <div class="flex items-center">
            <Coffee class="mr-2" /> <p class="text text-gray-600">Brew your coffee</p>
            </div>
        </div>
        <div class="mt-4">
            <p class="text-gray-600 mt-2">
            A charming sea-view apartment featuring a fully-equipped kitchen and two air-conditioned bedrooms (sleeping 4, with a sofa bed that converts to a double bed for a total of 6 guests). Just a 2-minute walk from Xlendi beach, surrounded by a variety of restaurants, bars, and coffee shops, and near a grocery store. The property includes a spacious balcony with stunning sunset views, perfect for a romantic dinner. Complimentary Wi-Fi is included.
            </p>
            <a href="/about" class="btn btn-sm btn-outline mt-3">Read more</a>
        </div>
    </div>
    <div class="p-4">
    <BookNow />
    </div>
</div>
