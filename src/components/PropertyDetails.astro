---
import amenities from "../data/amenities.json";
import PropertyMap from "./PropertyMap.astro";
import GettingToXlendi from '../components/planning/GettingToXlendi.md';
import property from "../data/property.json";
const totalAmenities = amenities.categories.reduce(
  (acc, category) => category.unavailable ? acc: acc + category.items.length,
  0
);
---

<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Where you'll sleep</h3>
  <div class="grid grid-cols-2 gap-4 mt-2">
    <div
      class="card p-2 h-32 bg-cover bg-center rounded-lg text-white flex flex-col justify-end"
      style="background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('https://a0.muscache.com/im/pictures/miso/Hosting-559907383709411950/original/ad8e3716-2ab7-4509-b598-859c32b0f87d.jpeg?im_w=1200')"
    >
      <span class="font-bold text-white">Bedroom 1</span>
      <span class="text-white">1 queen bed, 2 sofa beds</span>
    </div>
    <div
      class="card p-2 h-32 bg-cover bg-center rounded-lg text-white flex flex-col justify-end"
      style="background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('https://a0.muscache.com/im/pictures/miso/Hosting-559907383709411950/original/fc2f155c-b9d0-43ea-aa91-21c2d1636fc9.jpeg?im_w=720')"
    >
      <span class="font-bold text-white">Bedroom 2</span>
      <span class="text-white">1 double bed or 2 single beds</span>
    </div>
  </div>
</div>
<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">What this place offers</h3>
  <div class="grid grid-cols-2 gap-4 mt-2">
    {
      amenities.topAmenities.map((amenity) => (
        <div class="flex items-center">
          <span class="text-blue-500 mr-2">✔</span> {amenity}
        </div>
      ))
    }
  </div>
  <button class="btn btn-sm btn-outline mt-2" onclick="amenities_modal.showModal()"
    >Show all {totalAmenities} amenities</button
  >
</div>

<dialog id="amenities_modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box">
    <h2 class="text-2xl font-bold mb-4">What this place offers</h2>
    <div>
      {
        amenities.categories.map((category) => (
          <div>
            <h3 class="text-xl font-semibold mb-2 text-gray-800">
              {category.category}
            </h3>
            <ul class="list-disc list-inside text-gray-600">
              {category.items.map((item) => (
                <div class="flex items-center">
                  <span class={category.unavailable ? "line-through" : ""}>
                    <span class="text-blue-500 mr-2">✔</span> {item}
                  </span>
                </div>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Close</button>
      </form>
    </div>
  </div>
</dialog>

<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Where you'll be</h3>
  <p>Find us on Google: <a href={property.location.googleBusiness} target="_blank" class="text-blue-500 hover:underline">{property.subtitle}</a></p>
  <PropertyMap />
</div>

<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Getting There</h3>
  <GettingToXlendi />
</div>
