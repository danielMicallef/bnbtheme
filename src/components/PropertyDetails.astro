---
import amenities from "../data/amenities.json";
import PropertyMap from "./PropertyMap.astro";
import GettingToXlendi from '../components/planning/GettingToXlendi.astro';
import property from "../data/property.json";
import { Mail, PhoneCall } from '@lucide/astro';
const totalAmenities = amenities.categories.reduce(
  (acc, category) => category.unavailable ? acc: acc + category.items.length,
  0
);
---

<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Where you'll sleep</h3>
  <div class="grid grid-cols-2 gap-4 mt-2">
    {
      property.bedrooms.map((bedroom) => (
        <div
          class="card p-2 h-32 bg-cover bg-center rounded-lg text-white flex flex-col justify-end"
          style={`background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('${bedroom.image}')`}
        >
          <span class="font-bold text-white">{bedroom.name}</span>
          <span class="text-white">{bedroom.description}</span>
        </div>
      ))
    }
  </div>
</div>
<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">What this place offers</h3>
  <div class="grid grid-cols-2 gap-4 mt-2">
    {
      amenities.topAmenities.map((amenity) => (
        <div class="flex items-center">
          <span class="text-blue-500 mr-2">✔</span> {amenity}
        </div>
      ))
    }
  </div>
  <button class="btn btn-sm btn-outline mt-2" onclick="amenities_modal.showModal()"
    >Show all {totalAmenities} amenities</button
  >
</div>

<dialog id="amenities_modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box">
    <h2 class="text-2xl font-bold mb-4">What this place offers</h2>
    <div>
      {
        amenities.categories.map((category) => (
          <div>
            <h3 class="text-xl font-semibold mb-2 text-gray-800">
              {category.category}
            </h3>
            <ul class="list-disc list-inside text-gray-600">
              {category.items.map((item) => (
                <div class="flex items-center">
                  <span class={category.unavailable ? "line-through" : ""}>
                    <span class="text-blue-500 mr-2">✔</span> {item}
                  </span>
                </div>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Close</button>
      </form>
    </div>
  </div>
</dialog>


<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Getting Here</h3>
  <GettingToXlendi />
</div>

<div class="p-6 border-b border-gray-200">
  <h3 class="text-xl font-semibold">Things to know</h3>
  <div class="grid md:grid-cols-3 space-y-2">
    <div>
      <h4 class="text-lg">House Rules</h4>
      <p>Check-in: After 3:00 PM</p>
      <p>Check-out: Before 10:00 AM</p>
      <p>6 guests maximum</p>
    </div>
    <div>
      <h4 class="text-lg">Cancellation Policy</h4>
      <p>Cancel up to 7 days before to get a full refund (when booking directly)</p>
    </div>
    <div>
      <h4 class="text-lg">Contact</h4>
      <p><a class="flex items-center" href={`tel:${property.contact.phone}`}><PhoneCall class="mr-2" />{property.contact.phone}</a></p>
      <p><a class="flex items-center" target="_blank" href={`mailto:${property.contact.email}`}><Mail class="mr-2" />{property.contact.email}</a></p>
    </div>
  </div>
  
</div>
