---
import "../assets/app.css";
import property from "../data/property.json";
import { getImage } from "astro:assets";
import mainPhoto from "../assets/images/01_gallery_a.webp";

export interface Props { title?: string; description?: string; }
const {
  title = property.title,
  description = "A sea-view apartment in Xlendi, Gozo, sleeping up to six guests — two minutes from the beach.",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({ src: mainPhoto, width: 1200, height: 630, format: "jpg" });
const path = Astro.url.pathname;
const active = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title === property.title ? title : `${title} · Sunset Seaview`}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href="/">Sunset Seaview <span class="brand-location"><span class="brand-dot">·</span> Xlendi</span></a>
        <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">☰</button>
        <div class="nav-links">
          <a class:list={[{ active: active("/apartment") }]} href="/apartment">The apartment</a>
          <a class:list={[{ active: active("/planning") }]} href="/planning">Planning your trip</a>
          <a class:list={[{ active: active("/getting-here") || active("/map") || active("/transfer") || active("/car-hire") }]} href="/getting-here">Getting here</a>
          <a class:list={[{ active: active("/contact") }]} href="/contact">Contact</a>
          <a class="button small" href="/book">Book now</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>© {new Date().getFullYear()} Sunset Seaview Apartment, Xlendi, Gozo</span>
        <div class="footer-links"><a href="tel:+35679416569">+356 7941 6569</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const links = document.querySelector<HTMLElement>(".nav-links");
      toggle?.addEventListener("click", () => {
        const open = links?.classList.toggle("open") ?? false;
        toggle.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("menu-open", open);
      });
    </script>
  </body>
</html>
