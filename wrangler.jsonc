{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seaview-apartment-xlendi",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ]
}
